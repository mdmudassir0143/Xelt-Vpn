# Xelt x402 resource server — Arbitrum / USDC / Particle UA. Copy to .env and fill in.
PORT=4021
BORINGTUN_API_URL=http://127.0.0.1:8080

# Settlement (Arbitrum One mainnet — Particle UA is mainnet-only)
ARB_CHAIN_ID=42161
ARB_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# The VPN service's address that RECEIVES per-use USDC payments.
PAYEE_ADDRESS=

# Particle project keys — used to verify UA settlements via getTransaction.
PARTICLE_PROJECT_ID=
PARTICLE_CLIENT_KEY=
PARTICLE_APP_ID=

# Pricing (USD/min, paid in USDC)
PRICE_PER_MINUTE_USD=0.02
DEFAULT_SESSION_MINUTES=5
MIN_SESSION_MINUTES=1
MAX_SESSION_MINUTES=60
RENEW_WINDOW_SECONDS=30

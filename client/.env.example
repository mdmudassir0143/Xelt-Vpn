# vpn-server host (x402 API on :4021, WireGuard on :51820). 127.0.0.1 for same-machine dev.
VITE_SERVER_IP=127.0.0.1

# x402 API base (optional override)
VITE_X402_API_URL=http://localhost:4021

# Session length in minutes
VITE_SESSION_MINUTES=5

# --- Wallet layer: Magic (login) + Particle Universal Accounts (EIP-7702) on Arbitrum ---
# Copy to .env.local and fill in. These are CLIENT-SAFE keys (VITE_* ship in the bundle);
# the Particle Server Key and Magic Secret Key are server-side only — never put them here.
VITE_PARTICLE_PROJECT_ID=
VITE_PARTICLE_CLIENT_KEY=
VITE_PARTICLE_APP_ID=
VITE_MAGIC_PK=
# Arbitrum One settlement (UA is mainnet-only). Defaults are baked into config.ts.
VITE_ARB_CHAIN_ID=42161
VITE_ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
VITE_ARB_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# The VPN service's Arbitrum address that receives per-use x402 payments.
VITE_VPN_PAYEE=
